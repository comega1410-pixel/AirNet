<% layout("layouts/boilerplate") %>

<div class="container my-5 text-center py-5">
    <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
        <i class="fa-solid fa-triangle-exclamation fs-1"></i>
    </div>
    <h2 class="fw-bold mb-2">Something Went Wrong</h2>
    <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">
        <%= typeof error !== 'undefined' && error.message ? error.message : "An unexpected server error occurred on AirNet." %>
    </p>
    <a href="/listings" class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow">
        <i class="fa-solid fa-arrow-left me-2"></i> Go Back to Home
    </a>
</div>
