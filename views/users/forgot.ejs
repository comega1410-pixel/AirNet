<% layout("layouts/boilerplate") %>

<div class="container my-5" style="max-width: 520px;">
    <div class="form-card text-center">
        <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
            <i class="fa-solid fa-key fs-2"></i>
        </div>
        <h3 class="fw-bold mb-2">Forgot Password?</h3>
        <p class="text-muted small mb-4">Enter your registered email address and we will send you a password reset link.</p>

        <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
            <div class="mb-4 text-start">
                <label class="form-label fw-bold small">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                    <input type="email" name="email" class="form-control rounded-end-3" placeholder="name@example.com" required>
                </div>
            </div>

            <button type="submit" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold shadow mb-3">
                <i class="fa-solid fa-paper-plane me-2"></i> Send Reset Link
            </button>

            <a href="/login" class="btn btn-link text-muted small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
        </form>
    </div>
</div>
