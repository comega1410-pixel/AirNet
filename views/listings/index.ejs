<% layout("layouts/boilerplate") %>

<!-- Category & Filters Bar -->
<div class="filters-bar-wrapper">
    <div class="container-fluid px-md-4 d-flex align-items-center justify-content-between gap-3">
        <!-- Scrollable Category Pills -->
        <div class="filters-bar">
            <a href="/listings" class="filter-item <%= (!currentCategory && !currentPropertyType && !currentState && !currentCity) ? 'active' : '' %>">
                <i class="fa-solid fa-fire text-danger"></i>
                <span>Trending</span>
            </a>
            <a href="/listings?state=Gujarat" class="filter-item <%= currentState === 'Gujarat' ? 'active' : '' %>">
                <i class="fa-solid fa-location-dot text-warning"></i>
                <span>Gujarat Stays</span>
            </a>
            <a href="/listings?propertyType=OYO+Hotel" class="filter-item <%= currentPropertyType === 'OYO Hotel' ? 'active' : '' %>">
                <i class="fa-solid fa-hotel text-danger"></i>
                <span>OYO Hotels</span>
            </a>
            <a href="/listings?category=Villas" class="filter-item <%= currentCategory === 'Villas' ? 'active' : '' %>">
                <i class="fa-solid fa-house-chimney-window"></i>
                <span>Villas</span>
            </a>
            <a href="/listings?category=Hill+Stations" class="filter-item <%= currentCategory === 'Hill Stations' ? 'active' : '' %>">
                <i class="fa-solid fa-mountain-sun"></i>
                <span>Hill Stations</span>
            </a>
            <a href="/listings?category=Beachfront" class="filter-item <%= currentCategory === 'Beachfront' ? 'active' : '' %>">
                <i class="fa-solid fa-umbrella-beach"></i>
                <span>Beachfront</span>
            </a>
            <a href="/listings?category=Havelis" class="filter-item <%= currentCategory === 'Havelis' ? 'active' : '' %>">
                <i class="fa-solid fa-landmark"></i>
                <span>Heritage Havelis</span>
            </a>
            <a href="/listings?category=Houseboats" class="filter-item <%= currentCategory === 'Houseboats' ? 'active' : '' %>">
                <i class="fa-solid fa-ship"></i>
                <span>Houseboats</span>
            </a>
            <a href="/listings?category=Luxury" class="filter-item <%= currentCategory === 'Luxury' ? 'active' : '' %>">
                <i class="fa-solid fa-gem"></i>
                <span>Luxury Resorts</span>
            </a>
            <a href="/listings?category=Pilgrimage" class="filter-item <%= currentCategory === 'Pilgrimage' ? 'active' : '' %>">
                <i class="fa-solid fa-hands-praying"></i>
                <span>Pilgrimage</span>
            </a>
        </div>

        <!-- Right Side: Filters Modal Trigger & Tax Switch Box -->
        <div class="d-flex align-items-center gap-3 ms-auto">
            <!-- Senior Developer Filters Button -->
            <button type="button" class="btn btn-outline-dark rounded-pill px-3 py-2 fw-bold small text-nowrap d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#filtersModal">
                <i class="fa-solid fa-sliders text-danger"></i>
                <span>Filters</span>
            </button>

            <!-- 18% GST Tax Switch Box -->
            <div class="tax-toggle-box d-none d-xl-flex align-items-center gap-3" style="min-width: 210px;">
                <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                    <label class="form-check-label fw-bold text-nowrap small" for="flexSwitchCheckDefault">Display 18% GST</label>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Container -->
<div class="container-fluid px-md-4 my-4">
    
    <!-- Quick City Pills Row (Senior Developer Shortlist Bar) -->
    <div class="d-flex align-items-center justify-content-between bg-white p-3 rounded-4 shadow-sm border mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="small fw-bold text-muted me-1"><i class="fa-solid fa-bolt text-warning me-1"></i> Quick Shortlist:</span>
            <a href="/listings" class="badge <%= (!currentCity && !currentState && !currentCategory && !currentPropertyType) ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">All 40+ Stays</a>
            <a href="/listings?state=Gujarat&city=Surat" class="badge <%= currentCity === 'Surat' ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">Surat</a>
            <a href="/listings?state=Gujarat&city=Ahmedabad" class="badge <%= currentCity === 'Ahmedabad' ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">Ahmedabad</a>
            <a href="/listings?state=Gujarat&city=Vadodara" class="badge <%= currentCity === 'Vadodara' ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">Vadodara</a>
            <a href="/listings?state=Maharashtra&city=Mumbai" class="badge <%= currentCity === 'Mumbai' ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">Mumbai</a>
            <a href="/listings?state=Delhi+NCR&city=Delhi" class="badge <%= currentCity === 'Delhi' ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">Delhi</a>
            <a href="/listings?search=Goa" class="badge <%= currentSearch === 'Goa' ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">Goa</a>
            <a href="/listings?search=Jaipur" class="badge <%= currentSearch === 'Jaipur' ? 'bg-danger' : 'bg-light text-dark border' %> rounded-pill px-3 py-2 text-decoration-none">Jaipur</a>
        </div>

        <% if (currentSearch || currentCategory || currentPropertyType || currentState || currentCity) { %>
            <a href="/listings" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold ms-auto">
                <i class="fa-solid fa-xmark me-1"></i> Clear Filters
            </a>
        <% } %>
    </div>

    <!-- Active Search/Filter Banner -->
    <% if (currentSearch || currentCategory || currentPropertyType || currentState || currentCity) { %>
        <div class="bg-white p-3 rounded-4 shadow-sm mb-4 border d-flex align-items-center justify-content-between">
            <h5 class="fw-bold m-0 fs-6">
                Showing Stays
                <% if (currentState) { %> in State: <span class="text-danger"><%= currentState %></span> <% } %>
                <% if (currentCity) { %> in City: <span class="text-danger"><%= currentCity %></span> <% } %>
                <% if (currentCategory) { %> Category: <span class="text-danger"><%= currentCategory %></span> <% } %>
                <% if (currentPropertyType) { %> Service: <span class="text-danger"><%= currentPropertyType %></span> <% } %>
                <% if (currentSearch) { %> Search: "<span class="text-danger"><%= currentSearch %></span>" <% } %>
                (<%= allListings ? allListings.length : 0 %> properties found)
            </h5>
        </div>
    <% } %>

    <!-- Listing Cards Grid -->
    <% if (allListings && allListings.length > 0) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% for(let listing of allListings) { %>
                <div class="col">
                    <a href="/listings/<%= listing._id %>" class="listing-card">
                        <div class="card-img-wrapper">
                            <img src="<%= (listing.images && listing.images.length > 0 && listing.images[0].url) ? listing.images[0].url : (listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80') %>" 
                                 alt="<%= listing.title %>" loading="lazy">
                            
                            <button class="fav-heart-btn" type="button" title="Save to wishlist">
                                <i class="fa-regular fa-heart"></i>
                            </button>

                            <% if (listing.propertyType === 'OYO Hotel' || listing.isOYOVerified) { %>
                                <span class="badge-oyo-tag"><i class="fa-solid fa-check-circle me-1"></i> OYO Welcomed</span>
                            <% } else { %>
                                <span class="badge-property-tag"><%= listing.propertyType || listing.category || 'Stay' %></span>
                            <% } %>

                            <% if (listing.coupleFriendly) { %>
                                <span class="badge-feature-pill"><i class="fa-solid fa-heart text-danger me-1"></i> Couple Friendly</span>
                            <% } %>
                        </div>
                        <div class="card-content">
                            <div class="card-location-row">
                                <div class="card-location"><%= listing.city || listing.location %>, <%= listing.state || listing.country %></div>
                                <div class="card-rating">
                                    <i class="fa-solid fa-star"></i> <%= listing.rating ? listing.rating.toFixed(2) : '4.85' %>
                                </div>
                            </div>
                            <div class="card-title-sub"><%= listing.title %></div>
                            
                            <div class="text-muted small mb-2 d-flex align-items-center gap-2">
                                <span><i class="fa-solid fa-user-group me-1"></i><%= listing.guests || 2 %> Guests</span>
                                &bull;
                                <span><i class="fa-solid fa-bed me-1"></i><%= listing.bedrooms || 1 %> Bed</span>
                            </div>

                            <!-- Price Row with Data Attributes for Real-Time Currency Conversion -->
                            <div class="card-price-row" data-inr-price="<%= listing.price || 0 %>">
                                <span class="currency-symbol">₹</span><span class="base-price-val"><%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span> 
                                <span class="fw-normal text-muted small">/ night</span>
                                <span class="tax-info text-success ms-1 fw-bold">
                                    (incl. 18% GST = <span class="tax-symbol">₹</span><span class="tax-total-val"><%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : '0' %></span>)
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border my-4">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 90px; height: 90px;">
                <i class="fa-solid fa-hotel fs-1 text-danger"></i>
            </div>
            <h4 class="fw-bold mb-2">No Stays Found for Selected Filters</h4>
            <p class="text-muted mb-4">Try selecting Surat, Ahmedabad, Vadodara, Mumbai, Delhi, or click below to view all trial stays.</p>
            <a href="/listings" class="btn btn-danger rounded-pill px-4 fw-bold shadow">Explore All AirNet Stays</a>
        </div>
    <% } %>
</div>