<% layout("layouts/boilerplate") %>

<%
  /* ── Safe helpers so the page never crashes on any missing field ── */
  const _id         = listing._id;
  const _title      = listing.title        || 'Unnamed Stay';
  const _price      = listing.price        || 0;
  const _location   = listing.location     || '';
  const _city       = listing.city         || _location;
  const _state      = listing.state        || 'India';
  const _country    = listing.country      || 'India';
  const _desc       = listing.description  || 'No description available.';
  const _type       = listing.propertyType || 'Stay';
  const _guests     = listing.guests       || 2;
  const _bedrooms   = listing.bedrooms     || 1;
  const _beds       = listing.beds         || 1;
  const _bathrooms  = listing.bathrooms    || 1;
  const _rating     = listing.rating       ? listing.rating.toFixed(2) : '4.85';
  const _reviews    = listing.reviews      || [];
  const _amenities  = listing.amenities    || [];
  const _oyo        = listing.isOYOVerified || listing.propertyType === 'OYO Hotel';
  const _couple     = listing.coupleFriendly;
  const _payAtHotel = listing.payAtHotel;
  const _breakfast  = listing.freeBreakfast;
  const _coords     = (listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates : [78.9629, 20.5937];
  const _lat        = _coords[1];
  const _lng        = _coords[0];
  const _ownerName  = (listing.owner && listing.owner.username) ? listing.owner.username : 'Chaudhary Arpit Shailendra';
  const _ownerImg   = (listing.owner && listing.owner.avatar)   ? listing.owner.avatar   : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80';

  /* Main & fallback images */
  const _imgMain = (listing.images && listing.images.length > 0)
    ? listing.images[0].url
    : (listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80');

  const _fallbackSubs = [
    'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1614540424025-f57cf0de4e8c?auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=800&q=80'
  ];

  const _priceInr  = _price.toLocaleString('en-IN');
  const _taxAmt    = Math.round(_price * 0.18).toLocaleString('en-IN');
  const _totalAmt  = Math.round(_price * 1.18 + 250).toLocaleString('en-IN');
%>

<!-- Hidden inputs for JS -->
<input type="hidden" id="listingIdVal"    value="<%= _id %>">
<input type="hidden" id="pricePerNightVal" value="<%= _price %>">
<input type="hidden" id="listingLat"      value="<%= _lat %>">
<input type="hidden" id="listingLng"      value="<%= _lng %>">
<input type="hidden" id="listingTitle"    value="<%= _title.replace(/"/g,'&quot;') %>">
<input type="hidden" id="listingLocation" value="<%= (_location + ', ' + _city + ', ' + _state).replace(/"/g,'&quot;') %>">

<!-- ===================== SPLIT-SCREEN WRAPPER ===================== -->
<div class="show-split-layout">

  <!-- ========== LEFT PANEL: Scrollable Details ========== -->
  <div class="show-left-panel">

    <!-- Back Button -->
    <div class="px-4 pt-4 pb-2">
      <a href="/listings" class="btn btn-light border rounded-pill px-3 py-1 fw-bold small shadow-sm">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to All Stays
      </a>
    </div>

    <!-- ── PHOTO GALLERY ── -->
    <div class="px-4 pt-3 pb-0">
      <div class="gallery-hero-grid">

        <!-- Main hero image -->
        <div class="gallery-main-slot">
          <img src="<%= _imgMain %>" alt="<%= _title %>" class="gallery-main-img" id="galleryMainImg"
               onerror="this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80'">
          <% if (listing.images && listing.images.length > 1) { %>
            <button class="gallery-show-all-btn" type="button">
              <i class="fa-solid fa-images"></i> Show all photos
            </button>
          <% } %>
        </div>

        <!-- 4 sub-image thumbnails -->
        <div class="gallery-sub-grid">
          <% for (let i = 0; i < 4; i++) {
               let subSrc = (listing.images && listing.images[i+1]) ? listing.images[i+1].url : _fallbackSubs[i];
          %>
            <img src="<%= subSrc %>" alt="Photo <%= i+1 %>" class="gallery-sub-img"
                 onclick="swapGallery(this)"
                 onerror="this.src='<%= _fallbackSubs[i % 4] %>'">
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── PROPERTY HEADER ── -->
    <div class="px-4 pt-4">
      <!-- Badge row -->
      <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <% if (_oyo) { %>
          <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fa-solid fa-hotel me-1"></i> OYO Welcomed</span>
        <% } %>
        <span class="badge bg-dark rounded-pill px-3 py-2"><%= _type %></span>
        <% if (_couple) { %>
          <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fa-solid fa-heart text-danger me-1"></i> Couple Friendly</span>
        <% } %>
        <% if (_payAtHotel) { %>
          <span class="badge bg-success rounded-pill px-3 py-2"><i class="fa-solid fa-wallet me-1"></i> Pay at Check-In</span>
        <% } %>
        <% if (_breakfast) { %>
          <span class="badge rounded-pill px-3 py-2 text-white" style="background:#D97706;"><i class="fa-solid fa-mug-hot me-1"></i> Free Breakfast</span>
        <% } %>
      </div>

      <h1 class="show-title-main"><%= _title %></h1>

      <div class="show-meta-strip">
        <span><i class="fa-solid fa-star text-warning"></i> <strong><%= _rating %></strong>
          (<%= _reviews.length %> review<%= _reviews.length !== 1 ? 's' : '' %>)</span>
        <span class="meta-dot">·</span>
        <span><i class="fa-solid fa-location-dot text-danger"></i> <%= _city %>, <%= _state %>, India</span>
        <span class="meta-dot">·</span>
        <span><i class="fa-solid fa-users text-muted"></i> Up to <%= _guests %> guests</span>
      </div>
    </div>

    <div class="px-4"><hr class="my-4 show-divider"></div>

    <!-- ── HOST INFO ── -->
    <div class="px-4">
      <div class="show-host-card">
        <div class="d-flex align-items-center gap-3 flex-1">
          <img src="<%= _ownerImg %>" alt="Host" class="show-host-avatar"
               onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=300&q=80'">
          <div>
            <div class="show-host-name">Hosted by <%= _ownerName %></div>
            <div class="show-host-badge"><i class="fa-solid fa-shield-halved me-1"></i> AirNet Superhost · Verified Host</div>
          </div>
        </div>
        <div class="d-flex gap-2 ms-auto flex-shrink-0">
          <button class="btn btn-outline-dark btn-sm rounded-pill px-3 fav-heart-btn-show">
            <i class="fa-regular fa-heart me-1"></i> Save
          </button>
          <a href="/listings/<%= _id %>/edit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-pen me-1"></i> Edit
          </a>
        </div>
      </div>
    </div>

    <div class="px-4"><hr class="my-4 show-divider"></div>

    <!-- ── PROPERTY SPECS ── -->
    <div class="px-4">
      <h5 class="show-section-heading">Property Details</h5>
      <div class="show-specs-grid">
        <div class="spec-card-item">
          <i class="fa-solid fa-bed text-primary"></i>
          <div><div class="spec-label">Bedrooms</div><div class="spec-val"><%= _bedrooms %> Room<%= _bedrooms > 1 ? 's' : '' %></div></div>
        </div>
        <div class="spec-card-item">
          <i class="fa-solid fa-mattress-pillow text-warning"></i>
          <div><div class="spec-label">Beds</div><div class="spec-val"><%= _beds %> Bed<%= _beds > 1 ? 's' : '' %></div></div>
        </div>
        <div class="spec-card-item">
          <i class="fa-solid fa-bath text-info"></i>
          <div><div class="spec-label">Bathrooms</div><div class="spec-val"><%= _bathrooms %> Bath</div></div>
        </div>
        <div class="spec-card-item">
          <i class="fa-solid fa-users text-danger"></i>
          <div><div class="spec-label">Max Guests</div><div class="spec-val"><%= _guests %> Persons</div></div>
        </div>
      </div>
    </div>

    <div class="px-4"><hr class="my-4 show-divider"></div>

    <!-- ── DESCRIPTION ── -->
    <div class="px-4">
      <h5 class="show-section-heading">About this AirNet Stay</h5>
      <p class="show-description-text"><%= _desc %></p>
    </div>

    <div class="px-4"><hr class="my-4 show-divider"></div>

    <!-- ── AMENITIES ── -->
    <div class="px-4">
      <h5 class="show-section-heading">What this place offers</h5>
      <div class="amenities-grid-show">
        <% if (_amenities.length > 0) { %>
          <% _amenities.forEach(function(a) { %>
            <div class="amenity-item-show"><i class="fa-solid fa-circle-check text-success me-2"></i><%= a %></div>
          <% }); %>
        <% } else { %>
          <div class="amenity-item-show"><i class="fa-solid fa-wifi text-danger me-2"></i>High-Speed WiFi</div>
          <div class="amenity-item-show"><i class="fa-solid fa-snowflake text-info me-2"></i>Air Conditioning</div>
          <div class="amenity-item-show"><i class="fa-solid fa-tv text-dark me-2"></i>Smart TV</div>
          <div class="amenity-item-show"><i class="fa-solid fa-bolt text-warning me-2"></i>24/7 Power Backup</div>
          <div class="amenity-item-show"><i class="fa-solid fa-utensils text-success me-2"></i>Free Breakfast</div>
          <div class="amenity-item-show"><i class="fa-solid fa-car text-primary me-2"></i>Free Parking</div>
        <% } %>
      </div>
    </div>

    <div class="px-4"><hr class="my-4 show-divider"></div>

    <!-- ── TRANSIT DISTANCE SECTION ── -->
    <div class="px-4">
      <h5 class="show-section-heading"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Nearby Transit & Landmarks</h5>
      <p class="text-muted small mb-3">
        <i class="fa-solid fa-location-pin text-danger me-1"></i>
        <%= _location %>, <%= _city %>, <%= _state %> — distances from this property.
      </p>

      <div class="transit-grid">
        <!-- Railway Station -->
        <div class="transit-card">
          <div class="transit-icon-wrap train"><i class="fa-solid fa-train"></i></div>
          <div class="transit-info">
            <div class="transit-name"><%= _city %> Railway Station</div>
            <div class="transit-distance">~3.2 km away</div>
            <div class="transit-time">~10 min by auto/taxi</div>
          </div>
          <span class="transit-badge bg-success text-white">Train</span>
        </div>

        <!-- Bus Stop -->
        <div class="transit-card">
          <div class="transit-icon-wrap bus"><i class="fa-solid fa-bus"></i></div>
          <div class="transit-info">
            <div class="transit-name"><%= _city %> Central Bus Stop</div>
            <div class="transit-distance">~0.8 km away</div>
            <div class="transit-time">~5 min on foot</div>
          </div>
          <span class="transit-badge bg-warning text-dark">Bus</span>
        </div>

        <!-- Airport -->
        <div class="transit-card">
          <div class="transit-icon-wrap airport"><i class="fa-solid fa-plane-up"></i></div>
          <div class="transit-info">
            <div class="transit-name"><%= _city %> International Airport</div>
            <div class="transit-distance">~14.5 km away</div>
            <div class="transit-time">~25–35 min by taxi</div>
          </div>
          <span class="transit-badge bg-primary text-white">Airport</span>
        </div>

        <!-- Metro -->
        <div class="transit-card">
          <div class="transit-icon-wrap metro"><i class="fa-solid fa-train-subway"></i></div>
          <div class="transit-info">
            <div class="transit-name">Nearest Metro Station</div>
            <div class="transit-distance">~1.5 km away</div>
            <div class="transit-time">~8 min by e-rickshaw</div>
          </div>
          <span class="transit-badge bg-dark text-white">Metro</span>
        </div>
      </div>
    </div>

    <div class="px-4"><hr class="my-4 show-divider"></div>

    <!-- ── MOBILE BOOKING WIDGET (< lg screens) ── -->
    <div class="px-4 d-lg-none mb-4">
      <div class="booking-card-mobile">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div class="booking-price-header-mobile">₹<%= _priceInr %> <small class="text-muted fw-normal fs-6">/ night</small></div>
          <span class="fw-bold small"><i class="fa-solid fa-star text-warning"></i> <%= _rating %></span>
        </div>
        <form id="bookingFormMobile">
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label fw-bold small">Check-In</label>
              <input type="date" id="checkinDateMobile" class="form-control rounded-3">
            </div>
            <div class="col-6">
              <label class="form-label fw-bold small">Check-Out</label>
              <input type="date" id="checkoutDateMobile" class="form-control rounded-3">
            </div>
            <div class="col-12">
              <label class="form-label fw-bold small">Guests</label>
              <select class="form-select rounded-3">
                <option value="1">1 Guest</option>
                <option value="2" selected>2 Guests</option>
                <option value="3">3 Guests</option>
                <option value="4">4+ Guests</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn-primary-airnet mb-2"><i class="fa-solid fa-bolt me-1"></i> Reserve Now</button>
        </form>
        <p class="text-center text-muted small mb-0"><i class="fa-solid fa-shield-check text-success me-1"></i> Free Cancellation · Not charged yet</p>
      </div>
    </div>

    <!-- ── REVIEWS ── -->
    <div class="px-4 pb-5">
      <h5 class="show-section-heading">
        <i class="fa-solid fa-star text-warning me-2"></i>Guest Reviews
        <span class="badge bg-light text-dark border ms-2 fw-normal fs-6"><%= _reviews.length %></span>
      </h5>

      <!-- Rating summary -->
      <div class="reviews-rating-summary mb-4">
        <div class="big-rating-score">
          <span class="rating-number"><%= _rating %></span>
          <div>
            <div class="star-row">
              <% for(let s=0; s<5; s++) { %><i class="fa-solid fa-star text-warning"></i><% } %>
            </div>
            <div class="text-muted small">AirNet Guest Score</div>
          </div>
        </div>
        <div class="rating-bars">
          <div class="rating-bar-row"><span>Cleanliness</span><div class="rating-bar-track"><div class="rating-bar-fill" style="width:96%"></div></div><span>4.8</span></div>
          <div class="rating-bar-row"><span>Location</span><div class="rating-bar-track"><div class="rating-bar-fill" style="width:90%"></div></div><span>4.5</span></div>
          <div class="rating-bar-row"><span>Value</span><div class="rating-bar-track"><div class="rating-bar-fill" style="width:88%"></div></div><span>4.4</span></div>
          <div class="rating-bar-row"><span>Hospitality</span><div class="rating-bar-track"><div class="rating-bar-fill" style="width:98%"></div></div><span>4.9</span></div>
        </div>
      </div>

      <!-- Reviews list -->
      <% if (_reviews.length > 0) { %>
        <div class="reviews-list-grid mb-4">
          <% _reviews.forEach(function(review) { %>
            <div class="review-card-show">
              <div class="review-card-header">
                <div class="review-avatar"><i class="fa-solid fa-user"></i></div>
                <div>
                  <div class="review-author-name"><%= (review.author && review.author.username) ? review.author.username : 'Guest Traveler' %></div>
                  <div class="text-warning small">
                    <% for(let s=0; s<(review.rating||5); s++) { %>★<% } %>
                  </div>
                </div>
              </div>
              <p class="review-comment-text">"<%= review.comment || '' %>"</p>
              <form action="/listings/<%= _id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button class="btn btn-link text-danger p-0 small review-delete-btn"
                        onclick="return confirm('Delete this review?')">
                  <i class="fa-solid fa-trash-can me-1"></i>Remove
                </button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-4 bg-light rounded-4 mb-4">
          <i class="fa-regular fa-comment-dots fs-1 text-muted d-block mb-2"></i>
          <p class="text-muted mb-0">No reviews yet. Be the first to share your experience!</p>
        </div>
      <% } %>

      <!-- Add Review Form -->
      <div class="review-form-card">
        <h6 class="fw-bold mb-3"><i class="fa-solid fa-pen-to-square text-danger me-2"></i>Write a Review</h6>
        <form action="/listings/<%= _id %>/reviews" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
            <label class="form-label fw-bold small">Your Rating</label>
            <select name="review[rating]" class="form-select rounded-3" required>
              <option value="5" selected>⭐⭐⭐⭐⭐ (5 Stars – Outstanding)</option>
              <option value="4">⭐⭐⭐⭐ (4 Stars – Very Good)</option>
              <option value="3">⭐⭐⭐ (3 Stars – Average)</option>
              <option value="2">⭐⭐ (2 Stars – Poor)</option>
              <option value="1">⭐ (1 Star – Terrible)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold small">Your Experience</label>
            <textarea name="review[comment]" class="form-control rounded-3" rows="3"
                      placeholder="Share your experience: cleanliness, hospitality, location..." required></textarea>
          </div>
          <button type="submit" class="btn btn-dark rounded-pill px-4 fw-bold">Submit Review</button>
        </form>
      </div>
    </div>

  </div><!-- /show-left-panel -->

  <!-- ========== RIGHT PANEL: Sticky Map + Booking ========== -->
  <div class="show-right-panel">

    <!-- Sticky Booking Card (desktop only) -->
    <div class="booking-card-sticky d-none d-lg-block mb-3">
      <div class="d-flex align-items-baseline justify-content-between mb-3">
        <div class="booking-price-big">
          <span class="currency-symbol">₹</span><span class="base-price-val booking-price-amount"><%= _priceInr %></span>
          <small class="text-muted fw-normal ms-1">/ night</small>
        </div>
        <span class="fw-bold small"><i class="fa-solid fa-star text-warning"></i> <%= _rating %></span>
      </div>

      <form id="bookingForm" class="booking-form-fields">
        <div class="booking-date-grid">
          <div class="date-field-box border-end">
            <div class="date-field-label">CHECK-IN</div>
            <input type="date" id="checkinDate" class="date-field-input" required>
          </div>
          <div class="date-field-box">
            <div class="date-field-label">CHECK-OUT</div>
            <input type="date" id="checkoutDate" class="date-field-input" required>
          </div>
        </div>
        <div class="guest-field-box">
          <div class="date-field-label">GUESTS</div>
          <select id="guestSelect" class="guest-select-input">
            <option value="1">1 Guest</option>
            <option value="2" selected>2 Guests</option>
            <option value="3">3 Guests</option>
            <option value="4">4 Guests</option>
            <option value="5">5+ Guests</option>
          </select>
        </div>
        <button type="submit" class="btn-primary-airnet mt-2">
          <i class="fa-solid fa-bolt me-1"></i> Reserve / Book Now
        </button>
      </form>

      <!-- Price breakdown -->
      <div class="price-breakdown-box">
        <div class="price-breakdown-row">
          <span>Base Price (<span id="nightCountLabel">1 night</span>)</span>
          <span id="calcSubtotal">₹<%= _priceInr %></span>
        </div>
        <div class="price-breakdown-row">
          <span>GST (18%)</span>
          <span id="calcTax">₹<%= _taxAmt %></span>
        </div>
        <div class="price-breakdown-row">
          <span>AirNet Service Fee</span>
          <span>₹250</span>
        </div>
        <div class="price-breakdown-total">
          <span>Total</span>
          <span id="calcTotal" class="text-danger fw-bold">₹<%= _totalAmt %></span>
        </div>
      </div>

      <p class="text-center text-muted small mt-2 mb-0">
        <i class="fa-solid fa-shield-check text-success me-1"></i>Not charged yet · Free Cancellation
      </p>
    </div>

    <!-- ── INTERACTIVE LEAFLET MAP ── -->
    <div class="show-map-container">
      <div class="show-map-header">
        <i class="fa-solid fa-location-dot text-danger me-2"></i>
        <strong>Where you'll be</strong>
        <span class="text-muted small ms-2"><%= _city %>, <%= _state %></span>
      </div>

      <div id="map" class="show-map-leaflet"></div>

      <!-- Transit pills below map -->
      <div class="show-map-transit-pills">
        <span class="transit-pill transit-pill-train"><i class="fa-solid fa-train me-1"></i>Railway ~3.2km</span>
        <span class="transit-pill transit-pill-bus"><i class="fa-solid fa-bus me-1"></i>Bus ~0.8km</span>
        <span class="transit-pill transit-pill-airport"><i class="fa-solid fa-plane-up me-1"></i>Airport ~14.5km</span>
        <span class="transit-pill transit-pill-metro"><i class="fa-solid fa-train-subway me-1"></i>Metro ~1.5km</span>
      </div>
    </div>

  </div><!-- /show-right-panel -->

</div><!-- /show-split-layout -->

<!-- ── BOOKING CONFIRMATION MODAL ── -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-lg">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-success" id="bookingModalTitle">Booking Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4" id="bookingModalBody"></div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-dark rounded-pill w-100 fw-bold" data-bs-dismiss="modal">Done</button>
      </div>
    </div>
  </div>
</div>

<!-- ── INIT MAP + DEFAULT DATES ── -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  var lat  = parseFloat(document.getElementById('listingLat').value)  || 20.5937;
  var lng  = parseFloat(document.getElementById('listingLng').value)  || 78.9629;
  var title    = document.getElementById('listingTitle').value;
  var location = document.getElementById('listingLocation').value;

  // Initialise map with transit markers
  if (typeof initAirNetMapFull === 'function') {
    initAirNetMapFull(lat, lng, title, location);
  }

  // Default check-in / check-out
  var today    = new Date();
  var tomorrow = new Date(today);
  tomorrow.setDate(tomorrow.getDate() + 1);
  var fmt = function(d){ return d.toISOString().split('T')[0]; };

  ['checkinDate','checkinDateMobile'].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.value = fmt(today);
  });
  ['checkoutDate','checkoutDateMobile'].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.value = fmt(tomorrow);
  });
});

// Thumbnail click swap
function swapGallery(thumb) {
  var hero = document.getElementById('galleryMainImg');
  if (!hero) return;
  var old = hero.src;
  hero.src = thumb.src;
  thumb.src = old;
}
</script>